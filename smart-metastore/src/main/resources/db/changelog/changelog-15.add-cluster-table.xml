<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- unused legacy table -->
    <changeSet id="2026.10.08_001" author="tmanasyan">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="cluster_info"/>
        </preConditions>
        <dropTable tableName="cluster_info"/>
    </changeSet>

    <changeSet id="2026.10.08_002" author="tmanasyan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cluster"/>
            </not>
        </preConditions>
        <createTable tableName="cluster">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="cluster_name_key"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="hdfs_uri" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="hive_thrift_uri" type="TEXT"/>
            <column name="hdfs_nameservice" type="VARCHAR(255)"/>
            <column name="create_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
