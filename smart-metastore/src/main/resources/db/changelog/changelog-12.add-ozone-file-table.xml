<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2025.11.25_001" author="tmanasyan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ofile"/>
            </not>
        </preConditions>
        <createTable tableName="ofile">
            <column name="fid" autoIncrement="true" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="path" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="length" type="BIGINT"/>
            <column name="block_replication" type="SMALLINT"/>
            <column name="block_size" type="BIGINT"/>
            <column name="modification_time" type="BIGINT"/>
            <column name="access_time" type="BIGINT"/>
            <column name="is_volume" type="BOOLEAN"/>
            <column name="is_bucket" type="BOOLEAN"/>
            <column name="is_s3" type="BOOLEAN"/>
            <column name="owner" type="VARCHAR(255)"/>
            <column name="owner_group" type="VARCHAR(255)"/>
            <column name="permission" type="SMALLINT"/>
            <column name="ec_policy" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>