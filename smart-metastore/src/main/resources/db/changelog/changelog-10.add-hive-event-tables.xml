<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2025.09.09_001" author="tmanasyan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hive_metastore_event"/>
            </not>
        </preConditions>
        <createTable tableName="hive_metastore_event">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="external_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_name" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="catalog_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="db_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="table_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="message_format" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025.09.09_002" author="tmanasyan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ignored_hive_metastore_event"/>
            </not>
        </preConditions>
        <createTable tableName="ignored_hive_metastore_event">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="external_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_name" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="catalog_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="db_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="table_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="message_format" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>